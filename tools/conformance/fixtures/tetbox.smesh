// Conformance fixture tetbox: a 10 x 10 x 6 block, triangulated faces, tetmesh at size 1 (TET4).
let b = model.create_brick(x: 10.0, y: 10.0, z: 6.0)
mesh.size(targets: b.volume, size: 1.0)
mesh.scheme(targets: topo.related(kind: "TopoFace", within: b.volume), scheme: "trimesh")
mesh.scheme(targets: b.volume, scheme: "tetmesh")
let m = mesh.run(targets: b.volume)
fem.block_add(block: 1, volumes: b.volume)
fem.block_element_type(block: 1, element_type: "TET4")
fem.sideset_add(sideset: 1, faces: topo.related(kind: "TopoFace", within: b.volume), wrt: b.volume)
print "check", "tetbox", m.mesh[0]
