    def heal_check(self, *, blend_max_radius: float | None = ..., entities: Sequence[EntityId | str] | None = ..., hole_max_diameter: float | None = ..., sliver_aspect: float | None = ..., sliver_width: float | None = ..., small_edge: float | None = ..., small_face_area: float | None = ...) -> Any:
        """`model.heal_check {entities?, small_edge?, small_face_area?, sliver_aspect?, sliver_width?, hole_max_diameter?, blend_max_radius?}`: scan the model (or the closure of `entities`) for short edges, small and sliver faces, small holes, near gaps, open shells and blend candidates. Read-only; every finding is located and sorted by `(code, entity)`, and the thresholds used are returned with the findings. See [`mod@crate::heal_check`] for the rules."""

    def list(self, *, kind: Literal['TopoVertex', 'TopoEdge', 'TopoFace', 'TopoVolume', 'TopoBody', 'Curve', 'Surface', 'Color', 'Group', 'Boundary', 'Instance', 'Prototype', 'Lattice', 'Symmetry', 'Cluster', 'PartitionCell', 'PartitionFace', 'PartitionEdge', 'PartitionVertex', 'Mesh', 'MeshVertex', 'MeshEdge', 'MeshFace', 'MeshCell', 'Interface', 'MeshSet', 'MeshInstance']) -> Any:
        """`model.list {kind}`: every live entity of `kind` owned by the model layer, ascending."""

    def measure(self, *, entity: EntityId | str) -> Any:
        """`model.measure {entity}`: length, area, volume, centroid and bounding box of a topology cell."""

    def merge_check(self, *, entities: Sequence[EntityId | str] | None = ..., tol: float | None = ...) -> Any:
        """`model.merge_check {entities?, tol?}`: report what a merge would do, without changing anything: every candidate pair with its status (`mergeable`, `near`, `overlapping`, `conflict`, `skipped`), the measured gap, the overlap area where it applies, and a hint."""

    def region_tags(self, *, volumes: Sequence[EntityId | str] | None = ...) -> Any:
        """`model.region_tags {volumes?}`: the lattice frames and the region tags (of `volumes`, or of every tagged volume). Read-only. Consumers read region indices from here, never from the output order of an op."""

class RtQueries:
    """Queries `rt.*` (`s.q.rt.<query>(...)`; read-only)."""
    def check(self, *, mesh: EntityId | str, responses: Sequence[Mapping[str, Any]] = ...) -> Any:
        """`rt.check {mesh, responses?}`: can a tracker be built, and what does the build find?"""

    def check_overlaps(self, *, bodies: Sequence[EntityId | str] | None = ..., rays: int | None = ..., samples: int | None = ..., seed: int | None = ...) -> Any:
        """`rt.check_overlaps {bodies?, samples?, rays?, seed?}`: sampled overlap and gap check of the model seen as CSG cells (read-only; see [`csg_world`]). Stratified points and random chords are classified against every cell; two matching cells are a `csg.overlap` (with the point and both cells), none a `csg.gap`. The samples depend only on `seed` (default 0) and the cell geometry, so the findings are the same for any thread count and every repeat. The effective seed is part of the cached input and is echoed in the output."""

    def info(self, *, mesh: EntityId | str, responses: Sequence[Mapping[str, Any]] = ...) -> Any:
        """`rt.info {mesh, responses?}`: structure facts of the tracker built from a mesh."""

    def locate(self, *, dir: Sequence[float] | None = ..., mesh: EntityId | str, points: Sequence[Sequence[float]], responses: Sequence[Mapping[str, Any]] = ...) -> Any:
        """`rt.locate {mesh, points, dir?, responses?}`: the cell and region containing each point."""

    def partition(self, *, leaf_cells: int | None = ..., max_depth: int | None = ..., mesh: EntityId | str) -> Any:
        """`rt.partition {mesh, leaf_cells?, max_depth?}`: the structure of the majorant partition a delta-tracking code would use over a mesh (read-only; no cross section is involved, the split rule looks at regions and cell counts only)."""

class TopoQueries:
    """Queries `topo.*` (`s.q.topo.<query>(...)`; read-only)."""
    def related(self, *, kind: Literal['TopoVertex', 'TopoEdge', 'TopoFace', 'TopoVolume', 'TopoBody', 'Curve', 'Surface', 'Color', 'Group', 'Boundary', 'Instance', 'Prototype', 'Lattice', 'Symmetry', 'Cluster', 'PartitionCell', 'PartitionFace', 'PartitionEdge', 'PartitionVertex', 'Mesh', 'MeshVertex', 'MeshEdge', 'MeshFace', 'MeshCell', 'Interface', 'MeshSet', 'MeshInstance'], within: Sequence[EntityId | str]) -> Any:
        """`topo.related {kind, within}`: the live cells of `kind` related to the cells `within`."""

class ViewQueries:
    """Queries `view.*` (`s.q.view.<query>(...)`; read-only)."""
    def mesh_scalar(self, *, bad_above: float | None = ..., bad_below: float | None = ..., mesh: EntityId | str = ..., metric: str, worst: int = ...) -> Any:
        """Input of `view.mesh_scalar`."""

    def mesh_skin(self, *, clip: Mapping[str, Any] | None = ..., max_tris: int = ..., mesh: EntityId | str = ..., outline: bool = ..., volumes: Sequence[EntityId | str] | None = ...) -> Any:
        """Input of `view.mesh_skin`."""

    def scene(self) -> Any:
        """Input of `view.scene` (none)."""

    def tessellate(self, *, angle_tol: float | None = ..., chord_tol: float | None = ..., entities: Sequence[EntityId | str], max_edge: float | None = ...) -> Any:
        """Input of `view.tessellate`."""

class Ops:
    """`s.ops.<prefix>`: every op family."""
    fem: FemOps
    mesh: MeshOps
    model: ModelOps

class Queries:
    """`s.q.<prefix>`: every query family."""
    cad: CadQueries
    mesh: MeshQueries
    model: ModelQueries
    rt: RtQueries
    topo: TopoQueries
    view: ViewQueries
