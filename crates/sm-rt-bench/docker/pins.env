# Pins for the competitor images. Digests must be filled in on the benchmark machine before
# `smrt-bench docker-check` builds anything: `docker buildx imagetools inspect <image>:<tag>` prints
# the digest of the multi-arch index; copy the hex part after `sha256:`. UNSET is refused.
# Source commits are fixed in the Dockerfiles (double-down 437ad209eac5, XDG 83efb306e152).
MINIFORGE_DIGEST=UNSET
UBUNTU_DIGEST=UNSET
