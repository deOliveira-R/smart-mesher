{
  "name": "smart-mesh-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only WebGL2 viewer for smart-mesh (no runtime dependencies).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --strict -p tsconfig.json",
    "build": "node build.mjs",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .build/test/*.test.js",
    "e2e": "node e2e/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "esbuild": "0.24.2",
    "playwright-core": "1.49.1",
    "typescript": "5.7.2"
  }
}
